        var cut = [];
        if (changed) {
            return cut;
        }
        var frame = comp.frameDuration;
        for (i = 0; i < records.length; i++) {
            var one = records[i];
            var target = one.layer;
            var entry = { item: String(target.comment).substr(6), layer: target.name, id: target.id };
            var touched = false;
            if (one.end !== Infinity && one.end !== -Infinity) {
                var to = Math.ceil(one.end / frame - NEAR) * frame;
                if (to < target.outPoint - NEAR && to > target.inPoint + NEAR) {
                    entry.from = round(target.outPoint);
                    entry.to = round(to);
                    target.outPoint = to;
                    touched = true;
                }
