        return box;
    };

    function drawsSomething(layer) {
        return layer && layer.hasVideo && !layer.nullLayer && !(layer instanceof CameraLayer) &&
            !(layer instanceof LightLayer) && layer.enabled !== false;
    }

    // The elements a strike of a series belongs to: the layers that showed up last, by t (one frame apart).
    function arrivals(layers, t, frame) {
        var latest = -Infinity;
        var times = [];
        var i;
        for (i = 0; i < layers.length; i++) {
            var from = E.shownFrom(layers[i]);
            times.push(from);
            if (from !== null && from <= t + NEAR && from > latest) {
                latest = from;
            }
