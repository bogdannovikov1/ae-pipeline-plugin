        }
        found.unknown = (calls ? calls.length : 0) > parsed;
        return found;
    };

    function eachProperty(group, fn) {
        for (var n = 1; n <= group.numProperties; n++) {
            var p = group.property(n);
            if (!p) {
                continue;
            }
            if (p.propertyType === PropertyType.PROPERTY) {
                fn(p);
            } else {
                eachProperty(p, fn);
            }
        }
    }

    // Cuts hidden time off scene layers: the out point to the end of their last exit plus pad (rounded up to
    // a frame), the in point to their first appearance minus pad (rounded down). links: per item its targets
    // and its layers (a later item that targets an earlier one). Returns what was cut:
    // { item, layer, id, from, to } for the out point, in_from and in_to for the in point.
    E.trimHidden = function (comp, links, pad) {
        var records = [];
        var byId = {};
        var byIndex = {};
        var byName = {};
        var anyone = [];
        var i;
        var n;
        for (n = 1; n <= comp.numLayers; n++) {
            var layer = comp.layer(n);
            var r = { layer: layer, deps: [], end: Infinity, begin: -Infinity };
            var scene = /^scene:/.test(String(layer.comment));
            var plain = layer.hasVideo && !(layer instanceof CameraLayer) && !(layer instanceof LightLayer) &&
                layer.enabled !== false && !layer.isTrackMatte && !layer.locked;
            if (scene && plain && layer.nullLayer) {
