    // Time and opacity below this are taken as equal or as zero.
    var NEAR = 1e-4;

    // ---- No sound for what the viewer cannot see. Each placed sound remembers its journal entry by layer id.
    // The frame of a layer on screen at t, through its parents and the camera: the corners of its source rect
    // go through toComp in a probe expression, since scripting itself cannot project 3D. null: unknown.
    E.screenBox = function (layer, t) {
        var probe = E.probe;
        if (!probe) {
            return null;
        }
        var box = { left: Infinity, top: Infinity, right: -Infinity, bottom: -Infinity };
        var corners = [[0, 0], [1, 0], [0, 1], [1, 1]];
        for (var c = 0; c < corners.length; c++) {
            probe.position.expression = "var L = thisComp.layer(" + layer.index + ");\n" +
                "var r = L.sourceRectAtTime(" + t + ", false);\n" +
                "var p = L.toComp([r.left + r.width * " + corners[c][0] + ", r.top + r.height * " + corners[c][1] +
                ", 0], " + t + ");\n[p[0], p[1]];";
