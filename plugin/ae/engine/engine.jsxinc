                return null;
            }
            var p = probe.position.valueAtTime(t, false);
            box.left = Math.min(box.left, p[0]);
            box.top = Math.min(box.top, p[1]);
            box.right = Math.max(box.right, p[0]);
            box.bottom = Math.max(box.bottom, p[1]);
