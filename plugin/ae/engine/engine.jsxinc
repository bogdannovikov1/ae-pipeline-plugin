        var result = [];
        for (i = 0; i < layers.length; i++) {
            if (times[i] !== null && times[i] <= t + NEAR && times[i] >= latest - frame - NEAR) {
                result.push(layers[i]);
            }
        }
        return result;
    }

    // true: some layer of the group shows inside the frame (by more than margin px), false: every layer that
    // shows is out of frame, null: nothing shows at those moments or a frame is unknown. The first moment
    // where something shows decides.
    function onScreen(group, moments, comp, margin) {
        for (var m = 0; m < moments.length; m++) {
            var t = moments[m];
            var counted = false;
            for (var i = 0; i < group.length; i++) {
                var layer = group[i];
                if (t < layer.inPoint - NEAR || t >= layer.outPoint || layer.opacity.valueAtTime(t, false) <= NEAR) {
                    continue;
                }
                var box = E.screenBox(layer, t);
                if (!box) {
                    return null;
                }
                counted = true;
                if (box.right > margin && box.left < comp.width - margin && box.bottom > margin && box.top < comp.height - margin) {
                    return true;
                }
            }
            if (counted) {
                return false;
            }
        }
        return null;
    }

    // Removes sounds of objects wholly out of frame at the moment of the sound (its strike, else the middle of
    // the animation; if nothing shows yet, the end of the animation). A strike of a series goes only when the
    // elements that arrived with it are out of frame. byItem: item id -> its layers. Returns what went quiet.
    E.muteOffscreen = function (comp, byItem, margin) {
        var sounds = [];
        var muted = [];
        var n;
        for (n = 1; n <= comp.numLayers; n++) {
            var layer = comp.layer(n);
            if (!layer.hasVideo && E.soundLayers[layer.id]) {
                sounds.push({ layer: layer, entry: E.soundLayers[layer.id] });
            }
        }
        for (var s = 0; s < sounds.length; s++) {
            var entry = sounds[s].entry;
            var own = byItem[entry.item] || [];
            var visuals = [];
            for (var v = 0; v < own.length; v++) {
                if (drawsSomething(own[v])) {
                    visuals.push(own[v]);
                }
            }
            var at = entry.hit !== null && entry.hit !== undefined ? entry.hit : (entry.animation_start + entry.animation_end) / 2;
            var group = entry.role === "series" ? arrivals(visuals, at, comp.frameDuration) : visuals;
            if (onScreen(group, [at, entry.animation_end], comp, margin) !== false) {
                continue;
            }
            muted.push({ item: entry.item, sound: entry.sound, event: entry.event, role: entry.role, at: round(at) });
            for (var k = E.soundLog.length - 1; k >= 0; k--) {
                if (E.soundLog[k] === entry) {
