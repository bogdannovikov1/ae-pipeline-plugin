        function stop(r) {
            return Math.min(r.end, r.layer.outPoint);
        }
        function start(r) {
            return Math.max(r.begin, r.layer.inPoint);
        }
        var changed = true;
        for (var pass = 0; changed && pass <= 2 * records.length + 2; pass++) {
            changed = false;
            for (i = 0; i < records.length; i++) {
                var rec = records[i];
                var deps = rec.deps.concat(anyone);
                for (var d = 0; d < deps.length; d++) {
                    if (deps[d] === rec) {
                        continue;
                    }
                    if (rec.end !== Infinity && stop(deps[d]) > rec.end) {
