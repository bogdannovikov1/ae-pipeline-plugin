    // with only zero keys after it. null: the layer stays visible, never shows, or its opacity is not plain keys.
    E.hiddenAfter = function (layer) {
        var prop = layer.opacity;
        if (!prop || !prop.numKeys) {
            return null;
        }
        if (prop.expressionEnabled && prop.expression && !scalesValue(prop.expression)) {
            return null;
        }
        var count = prop.numKeys;
        var last = 0;
        for (var k = 1; k <= count; k++) {
            if (prop.keyValue(k) > NEAR) {
                last = k;
            }
        }
        if (last === 0 || last === count) {
            return null;
        }
        for (var z = last + 1; z < count; z++) {
            if (!flatAfter(prop, z)) {
                return null;
            }
        }
        return prop.keyTime(last + 1);
    };

    // When the layer first shows: the last zero key before the first visible one, with only zero keys before it.
    // null: it shows from its in point, never shows, or its opacity is not plain keys.
    E.hiddenBefore = function (layer) {
        var prop = layer.opacity;
        if (!prop || !prop.numKeys) {
            return null;
        }
        if (prop.expressionEnabled && prop.expression && !scalesValue(prop.expression)) {
            return null;
        }
        var first = 0;
        for (var k = prop.numKeys; k >= 1; k--) {
            if (prop.keyValue(k) > NEAR) {
                first = k;
            }
        }
        if (first <= 1) {
            return null;
        }
        for (var z = 1; z < first - 1; z++) {
            if (!flatAfter(prop, z)) {
                return null;
            }
        }
        return prop.keyTime(first - 1);
    };

    // The moment a layer starts to show (its in point when it shows from the start), null if never.
    E.shownFrom = function (layer) {
        var start = E.hiddenBefore(layer);
        if (start !== null) {
            return Math.max(start, layer.inPoint);
        }
        var prop = layer.opacity;
        if (!prop) {
            return layer.inPoint;
        }
        if (prop.numKeys) {
            for (var k = 1; k <= prop.numKeys; k++) {
                if (prop.keyValue(k) > NEAR) {
                    return k === 1 ? layer.inPoint : null;
                }
            }
            return null;
        }
        return prop.value > NEAR ? layer.inPoint : null;
    };

    // Layers an expression names: thisComp.layer("name") or layer(index). unknown: some layer( call whose
    // argument is not a plain name or number, so any layer may be read.
    E.layerRefs = function (text) {
        var found = { names: [], indices: [], unknown: false };
        var plain = /layer\(\s*("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*'|\d+)\s*\)/g;
        var calls = String(text).match(/layer\s*\(/g);
        var parsed = 0;
        var match;
        while ((match = plain.exec(text)) !== null) {
            parsed += 1;
            var arg = match[1];
            if (/^\d+$/.test(arg)) {
                found.indices.push(parseInt(arg, 10));
            } else {
                found.names.push(arg.substr(1, arg.length - 2).replace(/\\(.)/g, "$1"));
