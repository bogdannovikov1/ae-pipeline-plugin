    // ---- Layers that played their part. A layer whose opacity went to 0 for good is cut a little after
    // that exit, so AE stops computing it. Anything that may still need it keeps it: a child, an expression
    // or an effect that reads it, a later item that targets its item. When in doubt the layer stays.
    // An expression on opacity that only scales the keys ("value * 0.6", nested in brackets) keeps 0 at 0.
    function scalesValue(text) {
        var bare = String(text).replace(/\/\/[^\n]*/g, "").replace(/[\s();]/g, "");
        return /^value(\*\d*\.?\d+)*$/.test(bare);
