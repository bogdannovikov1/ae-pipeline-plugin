    // No overshoot after a key: linear, hold, or a bezier with zero speed on both sides of the segment.
    function flatAfter(prop, k) {
        var type = prop.keyOutInterpolationType(k);
        if (type === KeyframeInterpolationType.LINEAR || type === KeyframeInterpolationType.HOLD) {
            return true;
        }
        var out = prop.keyOutTemporalEase(k);
        var into = prop.keyInTemporalEase(k + 1);
        return Math.abs(out[0].speed) < NEAR && Math.abs(into[0].speed) < NEAR;
