// Scene engine: shared helpers for animation blocks. Blocks live in the base folder.

$.global.Engine = (function () {
    var E = { blocks: {}, store: {}, starts: {}, footage: {}, soundLog: [], soundCalls: {}, ends: {}, seam: null, current: "", tokens: null, assets: [], comp: null, base: "", timeline: null };

    // Returns a copy of base with patch applied over it: one item can restyle anything.
    E.overlay = function (base, patch) {
        var result = {};
        var key;
        for (key in base) {
            if (base.hasOwnProperty(key)) {
                result[key] = base[key];
            }
        }
        for (key in patch) {
            if (patch.hasOwnProperty(key)) {
                var nested = typeof patch[key] === "object" && patch[key] !== null && !(patch[key] instanceof Array);
                result[key] = nested && base[key] ? E.overlay(base[key], patch[key]) : patch[key];
            }
        }
        return result;
    };

    E.register = function (id, build) {
        E.blocks[id] = build;
    };

    E.rgb = function (hex) {
        var value = parseInt(hex.replace("#", ""), 16);
        return [(value >> 16 & 255) / 255, (value >> 8 & 255) / 255, (value & 255) / 255];
    };

    E.color = function (name) {
        return E.rgb(E.tokens.colors[name] || name);
    };

    // Time comes from a word marker, another item (after) or seconds, plus an optional delay.
    E.time = function (spec) {
        var delay = spec.delay || 0;
        if (spec.at_word !== undefined) {
            // The picture leads the voice: the viewer sees the object before hearing the word.
            return Math.max(0, E.timeline.words[spec.at_word].start - E.tokens.motion.lead + delay);
        }
        if (spec.after !== undefined) {
            return E.starts[spec.after] + delay;
        }
        if (spec.at !== undefined) {
            return spec.at + delay;
        }
        throw new Error("Item has no time: " + spec.block);
    };

    E.endTime = function (spec) {
        return spec.until_word === undefined ? null : E.timeline.words[spec.until_word].end;
    };

    function easeSize(prop) {
        if (prop.propertyValueType === PropertyValueType.ThreeD) {
            return 3;
        }
        return prop.propertyValueType === PropertyValueType.TwoD ? 2 : 1;
    }

    function easeSide(prop) {
        var ease = new KeyframeEase(0, E.tokens.motion.ease_influence);
        var side = [];
        for (var n = 0; n < easeSize(prop); n++) {
            side.push(ease);
        }
        return side;
    }

    // Eases the keys of a property; after a seam (append over a frozen part) only the keys from the seam on.
    E.smooth = function (prop) {
        var side = easeSide(prop);
        for (var k = 1; k <= prop.numKeys; k++) {
            if (E.seam === null || E.seam === undefined || prop.keyTime(k) >= E.seam - 1e-4) {
                prop.setTemporalEaseAtKey(k, side, side);
            }
        }
    };

    // Sets keys and eases only them: keys the property already had keep their curves.
    E.keys = function (prop, times, values) {
        for (var i = 0; i < times.length; i++) {
            prop.setValueAtTime(times[i], values[i]);
        }
        var side = easeSide(prop);
        for (var j = 0; j < times.length; j++) {
            prop.setTemporalEaseAtKey(prop.nearestKeyIndex(times[j]), side, side);
        }
    };

    // One continuous spring: a fast launch, a single small overshoot and a soft settle.
    // Damping is derived from the travel, so the overshoot stays the same size for any distance.
    // The curve is baked into frame keys: the author can slide the layer in time, move or delete keys, and
    // ae_run.py diff sees them. Only the calm drift stays an expression over the keyed position.
    E.springKeys = function (arrive, from, to, frame) {
        var token = E.tokens.motion.spring;
        var dx = from[0] - to[0];
        var dy = from[1] - to[1];
        var distance = Math.sqrt(dx * dx + dy * dy);
        var w = token.frequency;
        var k = -Math.log(token.overshoot / distance) * w / Math.PI;
        var start = arrive - Math.PI / (2 * w);
        var rest = token.rest === undefined ? 0.5 : token.rest;
        // The swing is under rest pixels from here on: the last key lands on the target.
        var settle = distance > rest ? Math.log(distance / rest) / k : 0;
        var steps = Math.max(1, Math.ceil(settle / frame));
        var times = [];
        var values = [];
        for (var n = 0; n <= steps; n++) {
            var t = n * frame;
            var s = n === steps ? 0 : Math.exp(-k * t) * Math.cos(w * t);
            times.push(start + t);
            values.push([to[0] + dx * s, to[1] + dy * s, 0]);
        }
        return { start: start, times: times, values: values };
    };

    E.spring = function (layer, arrive, from, to) {
        var keys = E.springKeys(arrive, from, to, E.comp.frameDuration);
        layer.threeDLayer = true;
        layer.position.setValuesAtTimes(keys.times, keys.values);
        // Straight path between the frame keys: auto-bezier would bulge past the overshoot.
        for (var n = 0; n < keys.times.length; n++) {
            var index = layer.position.nearestKeyIndex(keys.times[n]);
            layer.position.setSpatialTangentsAtKey(index, [0, 0, 0], [0, 0, 0]);
        }
        E.float(layer);
        return keys.start;
    };

    E.fadeIn = function (layer, t, duration) {
        layer.opacity.setValueAtTime(t, 0);
        layer.opacity.setValueAtTime(t + duration, 100);
    };

    E.fadeOut = function (layer, t, duration) {
        layer.opacity.setValueAtTime(t - duration, layer.opacity.valueAtTime(t - duration, false));
        layer.opacity.setValueAtTime(t, 0);
        layer.outPoint = t;
    };

    E.pop = function (layer, t) {
        var duration = E.tokens.motion.pop_duration;
        var over = E.tokens.motion.pop_overshoot;
        E.keys(layer.scale, [t, t + duration * 0.65, t + duration],
            [[0, 0, 100], [over, over, 100], [100, 100, 100]]);
        E.fadeIn(layer, t, duration * 0.3);
    };

    function addShadow(layer, token, colorName) {
        var effect = layer.property("ADBE Effect Parade").addProperty("ADBE Drop Shadow");
        effect.property("ADBE Drop Shadow-0001").setValue(E.color(colorName).concat([1]));
        effect.property("ADBE Drop Shadow-0002").setValue(token.opacity);
        effect.property("ADBE Drop Shadow-0003").setValue(token.direction);
        effect.property("ADBE Drop Shadow-0004").setValue(token.distance);
        effect.property("ADBE Drop Shadow-0005").setValue(token.softness);
    }

    // Depth comes from a dark shadow; a soft drop shadow gives the glow and keeps the exact burgundy.
    E.shadow = function (layer) {
        addShadow(layer, E.tokens.shadow.depth, "black");
    };

    // A hard offset shadow reads as the side of raised letters.
    E.extrude = function (layer) {
        addShadow(layer, E.tokens.shadow.extrude, "accent_red");
    };

    E.glow = function (layer, strong, colorName) {
        addShadow(layer, strong ? E.tokens.shadow.focus : E.tokens.shadow.glow, colorName || "glow");
    };

    // One calm vertical drift for all objects: they move together, so nothing sways.
    E.float = function (layer) {
        var motion = E.tokens.motion;
        layer.threeDLayer = true;
        layer.position.expression = "value + [0, Math.sin(time * " + motion.float_speed + ") * " + motion.float_shift + ", 0]";
    };

    // Layers of one object sit a little apart in depth: on a shared plane AE can flip their order.
    E.lift = function (layer, z) {
        var position = layer.position.value;
        layer.threeDLayer = true;
        layer.position.setValue([position[0], position[1], z]);
    };

    // Parent first, then the position in the parent's space. Assigning parent after a comp position lets AE
    // convert it through the parent's state at the comp's current time: a scaled or keyed parent shifts the child.
    // offset is the child's position in the parent's layer space; without it the child keeps its comp position
    // relative to the parent at rest (scale 100, no rotation). A 3D child keeps its depth.
    function rest(prop) {
        return prop.valueAtTime ? prop.valueAtTime(0, true) : prop.value;
    }

    E.attach = function (child, parent, offset) {
        var own = rest(child.position);
        if (!offset) {
            var p = rest(parent.position);
            var a = rest(parent.anchorPoint);
            offset = [own[0] - p[0] + a[0], own[1] - p[1] + a[1]];
        }
        child.setParentWithJump(parent);
        var z = offset.length > 2 ? offset[2] : (own.length > 2 ? own[2] : 0);
        child.position.setValue(child.threeDLayer ? [offset[0], offset[1], z] : [offset[0], offset[1]]);
        return child;
    };

    // ---- Manual edits of the author carried into the scene by ae_run.py diff --apply (field adjust).
    // Root layers of an item: its video layers without a parent among the item's own layers. A child follows.
    E.rootsOf = function (layers) {
        var own = {};
        var roots = [];
        var i;
        for (i = 0; i < layers.length; i++) {
            own[layers[i].id] = true;
        }
        for (i = 0; i < layers.length; i++) {
            if (layers[i].hasVideo && !(layers[i].parent && own[layers[i].parent.id])) {
                roots.push(layers[i]);
            }
        }
        return roots;
    };

    // Every key, or the still value before expressions, through fn.
    function mapValue(prop, fn) {
        if (!prop) {
            return;
        }
        if (prop.numKeys) {
            for (var k = 1; k <= prop.numKeys; k++) {
                prop.setValueAtKey(k, fn(prop.keyValue(k)));
            }
        } else {
            prop.setValue(fn(rest(prop)));
        }
    }

    function shift(value, offset) {
        var out = [];
        for (var i = 0; i < value.length; i++) {
            out.push(value[i] + (offset[i] || 0));
        }
        return out;
    }

    // adjust: { offset: [dx, dy(, dz)], scale: k, rotation: degrees } after the block, on its root layers,
    // over every key; the values are those of the layer itself, in its parent's space when it has one.
    E.adjust = function (layers, adjust) {
        if (!adjust) {
            return;
        }
        var roots = E.rootsOf(layers);
        for (var i = 0; i < roots.length; i++) {
            var transform = roots[i].property("ADBE Transform Group");
            if (!transform) {
                continue;
            }
            var offset = adjust.offset;
            var position = transform.property("ADBE Position");
            if (offset && position && position.dimensionsSeparated) {
                for (var d = 0; d < offset.length; d++) {
                    var delta = offset[d];
                    mapValue(transform.property("ADBE Position_" + d), function (v) { return v + delta; });
                }
            } else if (offset) {
                mapValue(position, function (v) { return shift(v, offset); });
            }
            var k = adjust.scale;
            if (k !== undefined && k !== null && k !== 1) {
                mapValue(transform.property("ADBE Scale"), function (v) {
                    var out = [];
                    for (var n = 0; n < v.length; n++) {
                        out.push(v[n] * k);
                    }
                    return out;
                });
            }
            var turn = adjust.rotation;
            if (turn) {
                mapValue(transform.property("ADBE Rotate Z"), function (v) { return v + turn; });
            }
        }
    };

    // adjust.layers: per layer of the item the author's own value or keys, replayed after the block and adjust.
    // A layer is named as ae_run.py diff names it: its name, and "name#2"... among same-named video layers of the
    // item, top first. Key times count from the item start, so a later delay carries them.
    var EDIT_PROPS = { position: "ADBE Position", scale: "ADBE Scale", rotation: "ADBE Rotate Z",
        opacity: "ADBE Opacity", anchor: "ADBE Anchor Point" };

    E.layerKeys = function (layers) {
        var video = [];
        var i;
        for (i = 0; i < layers.length; i++) {
            if (layers[i].hasVideo) {
                video.push(layers[i]);
            }
        }
        video.sort(function (a, b) { return a.index - b.index; });
        var named = {};
        for (i = 0; i < video.length; i++) {
            var key = video[i].name;
            var number = 1;
            while (named[key]) {
                number += 1;
                key = video[i].name + "#" + number;
            }
            named[key] = video[i];
        }
        return named;
    };

    function fit(value, like) {
        if (!(like instanceof Array) || !(value instanceof Array)) {
            return value;
        }
        var out = [];
        for (var i = 0; i < like.length; i++) {
            out.push(i < value.length ? value[i] : like[i]);
        }
        return out;
    }

    function easeOf(list) {
        var out = [];
        for (var i = 0; i < list.length; i++) {
            out.push(new KeyframeEase(list[i][0], Math.min(100, Math.max(0.1, list[i][1]))));
        }
        return out;
    }

    function curveAt(prop, k, curve) {
        if (!curve) {
            return;
        }
        // Each part on its own: a hold key has no ease, a 1D property no tangents.
        try {
            prop.setInterpolationTypeAtKey(k, curve.i[0], curve.i[1]);
        } catch (e1) {}
        try {
            prop.setTemporalEaseAtKey(k, easeOf(curve.e[0]), easeOf(curve.e[1]));
        } catch (e2) {}
        if (curve.s && prop.isSpatial) {
            try {
                prop.setSpatialTangentsAtKey(k, curve.s[0], curve.s[1]);
            } catch (e3) {}
        }
    }

    E.setEdit = function (prop, edit, start) {
        var like = rest(prop);
        while (prop.numKeys) {
            prop.removeKey(1);
        }
        if (!edit.keys) {
            prop.setValue(fit(edit.v, like));
            return;
        }
        var times = [];
        var values = [];
        var k;
        for (k = 0; k < edit.keys.length; k++) {
            times.push(start + edit.keys[k][0]);
            values.push(fit(edit.keys[k][1], like));
        }
        prop.setValuesAtTimes(times, values);
        for (k = 0; k < edit.keys.length; k++) {
            curveAt(prop, prop.nearestKeyIndex(times[k]), edit.keys[k][2]);
        }
    };

    // Returns the layer names it did not find: the block changed since the author's edit.
    E.layerEdits = function (layers, edits, start) {
        var lost = [];
        if (!edits) {
            return lost;
        }
        var named = E.layerKeys(layers);
        for (var key in edits) {
            if (!edits.hasOwnProperty(key)) {
                continue;
            }
            var layer = named[key];
            var transform = layer ? layer.property("ADBE Transform Group") : null;
            if (!transform) {
                lost.push(key);
                continue;
            }
            for (var name in edits[key]) {
                if (edits[key].hasOwnProperty(name) && EDIT_PROPS[name]) {
                    E.setEdit(transform.property(EDIT_PROPS[name]), edits[key][name], start);
                }
            }
        }
        return lost;
    };

    // adjust.below / adjust.above: the item's layers go right under the lowest or over the highest layer of
    // another item, keeping their own order. Both lists come sorted by index, top first.
    E.restack = function (mine, other, mode) {
        if (!mine.length || !other.length) {
            return;
        }
        var i;
        if (mode === "below") {
            var lowest = other[other.length - 1];
            for (i = mine.length - 1; i >= 0; i--) {
                mine[i].moveAfter(lowest);
            }
        } else {
            var highest = other[0];
            for (i = 0; i < mine.length; i++) {
                mine[i].moveBefore(highest);
            }
        }
    };

    // A block reports that an item left the screen at time (an exit animation): marks on it go with it.
    E.ended = function (id, time) {
        E.ends[id] = time;
    };

    // The ids an item points at through target or targets, among the items built so far.
    E.targetsOf = function (item) {
        var params = item.params || {};
        var list = params.targets instanceof Array ? params.targets : [params.target];
        var ids = [];
        for (var i = 0; i < list.length; i++) {
            if (typeof list[i] === "string" && E.starts[list[i]] !== undefined) {
                ids.push(list[i]);
            }
        }
        return ids;
    };

    // When an item left the screen: an exit reported by a block, else the last outPoint of its layers.
    // null: it stays to the end of the composition.
    E.endOf = function (id) {
        if (E.ends[id] !== undefined) {
            return E.ends[id];
        }
        var comp = E.comp;
        var last = null;
        for (var n = 1; n <= comp.numLayers; n++) {
            var layer = comp.layer(n);
            if (layer.hasVideo && layer.comment === "scene:" + id) {
                last = last === null ? layer.outPoint : Math.max(last, layer.outPoint);
            }
        }
        return last === null || last >= comp.duration - comp.frameDuration / 2 ? null : last;
    };

    // A mark on a target (a highlight, a pointer, a frame) does not outlive it: its layers fade out with the
    // target unless they end earlier. Items go in scene order, so a mark on a mark ends with the first one.
    E.endWithTargets = function (built) {
        var fade = E.tokens.motion.exit_duration;
        for (var i = 0; i < built.length; i++) {
            var b = built[i];
            var end = null;
            for (var k = 0; k < b.targets.length; k++) {
                var e = E.endOf(b.targets[k]);
                if (e === null) {
                    end = null;
                    break;
                }
                end = end === null ? e : Math.max(end, e);
            }
            if (end === null) {
                continue;
            }
            for (var n = 0; n < b.layers.length; n++) {
                var layer = b.layers[n];
                // Sounds, cameras and lights are not marks; a layer born after the end cannot be cut.
                if (!layer.hasVideo || layer instanceof CameraLayer || layer instanceof LightLayer ||
                    layer.outPoint <= end + 1e-4 || layer.inPoint >= end - 1e-4) {
                    continue;
                }
                if (layer.nullLayer) {
                    layer.outPoint = end;
                } else {
                    E.fadeOut(layer, end, Math.min(fade, end - layer.inPoint));
                }
            }
        }
    };

    E.rectFill = function (layer) {
        return layer.property("ADBE Root Vectors Group").property(1).property("ADBE Vectors Group")
            .property("ADBE Vector Graphic - Fill").property("ADBE Vector Fill Color");
    };

    E.rectSize = function (layer) {
        return layer.property("ADBE Root Vectors Group").property(1).property("ADBE Vectors Group")
            .property("ADBE Vector Shape - Rect").property("ADBE Vector Rect Size");
    };

    E.tag = function (layer, id) {
        layer.comment = "scene:" + id;
        return layer;
    };

    function addGroup(layer, name) {
        var group = layer.property("ADBE Root Vectors Group").addProperty("ADBE Vector Group");
        group.name = name;
        return group;
    }

    E.addStroke = function (group, color, width) {
        var stroke = group.property("ADBE Vectors Group").addProperty("ADBE Vector Graphic - Stroke");
        stroke.property("ADBE Vector Stroke Color").setValue(color);
        stroke.property("ADBE Vector Stroke Width").setValue(width);
        stroke.property("ADBE Vector Stroke Line Cap").setValue(2);
        stroke.property("ADBE Vector Stroke Line Join").setValue(2);
        return stroke;
    };

    E.rect = function (name, size, radius, position, fill, stroke) {
        var layer = E.comp.layers.addShape();
        layer.name = name;
        var group = addGroup(layer, "rect");
        var content = group.property("ADBE Vectors Group");
        var shape = content.addProperty("ADBE Vector Shape - Rect");
        shape.property("ADBE Vector Rect Size").setValue(size);
        shape.property("ADBE Vector Rect Roundness").setValue(radius);
        if (fill) {
            content.addProperty("ADBE Vector Graphic - Fill").property("ADBE Vector Fill Color").setValue(fill);
        }
        if (stroke) {
            E.addStroke(group, stroke.color, stroke.width);
        }
        layer.position.setValue(position);
        return layer;
    };

    // Coordinates are comp pixels: the layer stays at the comp origin.
    E.path = function (layer, name, points, inTangents, outTangents, closed) {
        var group = addGroup(layer, name);
        var path = new Shape();
        path.vertices = points;
        path.inTangents = inTangents;
        path.outTangents = outTangents;
        path.closed = closed;
        group.property("ADBE Vectors Group").addProperty("ADBE Vector Shape - Group")
            .property("ADBE Vector Shape").setValue(path);
        return group;
    };

    E.vectorLayer = function (name) {
        var layer = E.comp.layers.addShape();
        layer.name = name;
        layer.position.setValue([0, 0]);
        return layer;
    };

    E.text = function (name, value, style) {
        var layer = E.comp.layers.addText(value);
        layer.name = name;
        var prop = layer.property("ADBE Text Properties").property("ADBE Text Document");
        var doc = prop.value;
        doc.font = style.font;
        doc.fontSize = style.size;
        doc.applyFill = true;
        doc.fillColor = style.color;
        doc.applyStroke = false;
        doc.justification = style.left ? ParagraphJustification.LEFT_JUSTIFY : ParagraphJustification.CENTER_JUSTIFY;
        prop.setValue(doc);
        var box = layer.sourceRectAtTime(0, false);
        var anchorX = style.left ? 0 : box.left + box.width / 2;
        layer.anchorPoint.setValue([anchorX, box.top + box.height / 2]);
        layer.position.setValue(style.position);
        return layer;
    };

    E.font = function (kind) {
        return E.tokens.text.fonts[kind];
    };

    E.asset = function (id) {
        if (E.footage[id]) {
            return E.footage[id];
        }
        for (var i = 0; i < E.assets.length; i++) {
            if (E.assets[i].id === id) {
                var file = new File(E.base + "/assets/" + E.assets[i].file);
                E.footage[id] = Timeline.importOnce(file);
                return E.footage[id];
            }
        }
        throw new Error("Unknown asset: " + id);
    };

    function assetInfo(id) {
        for (var i = 0; i < E.assets.length; i++) {
            if (E.assets[i].id === id) {
                return E.assets[i];
            }
        }
        return {};
    }

    function audibleLength(id, layer) {
        return assetInfo(id).audible || layer.source.duration;
    }

    // Where the strike of the file is, from its start: measured peak, else the middle of what is heard.
    function hitOffset(id, audible) {
        var hit = assetInfo(id).hit;
        return hit === undefined ? audible / 2 : hit;
    }

    function round(value) {
        return Math.round(value * 1000) / 1000;
    }

    // Old tokens: an appearance picks its sound by how long it takes, other events name one sound.
    function legacySound(name, span) {
        var tiers = E.tokens.sounds.appear;
        if (tiers && (name === "pop" || name === "group")) {
            for (var i = 0; i < tiers.length; i++) {
                if (tiers[i].max === undefined || span <= tiers[i].max) {
                    return tiers[i].sound;
                }
            }
        }
        return E.tokens.sounds[name];
    }

    // The event's settings: its own, else the event it falls back to. null turns the sound off,
    // undefined means the tokens have no events for it and the old rules apply.
    function eventConfig(name) {
        var sounds = E.tokens.sounds;
        var events = sounds.events;
        if (!events) {
            return undefined;
        }
        var key = name;
        if (!events.hasOwnProperty(key)) {
            var fallback = sounds.fallback || {};
            if (fallback[name] === null) {
                return null;
            }
            key = fallback[name];
            if (key === undefined || !events.hasOwnProperty(key)) {
                return undefined;
            }
        }
        var config = events[key];
        if (typeof config === "string") {
            return { tiers: [config] };
        }
        return config || null;
    }

    // The tier whose heard length is closest to the animation: unmeasured files lose to measured ones.
    function closestTier(tiers, span) {
        var best = tiers[0];
        var bestDistance = Infinity;
        for (var i = 0; i < tiers.length; i++) {
            var audible = assetInfo(tiers[i]).audible;
            var distance = audible === undefined ? Infinity : Math.abs(audible - span);
            if (distance < bestDistance) {
                best = tiers[i];
                bestDistance = distance;
            }
        }
        return best;
    }

    // Stable per item: the same scene gets the same variants on every rebuild.
    function itemSeed() {
        var seed = 0;
        for (var i = 0; i < E.current.length; i++) {
            seed = (seed * 31 + E.current.charCodeAt(i)) % 100003;
        }
        return seed;
    }

    function nextCall() {
        var count = E.soundCalls[E.current] || 0;
        E.soundCalls[E.current] = count + 1;
        return count;
    }

    // A file goes in at its loudness: with a measured loudness it is brought to the common level.
    function gain(id, shift) {
        var sounds = E.tokens.sounds;
        var loudness = assetInfo(id).loudness;
        var level = sounds.level;
        if (loudness !== undefined && sounds.reference_loudness !== undefined) {
            level += sounds.reference_loudness - loudness;
        }
        return level + (shift || 0);
    }

    // Puts one file so that its strike lands at moment (null: centre to centre) and logs it.
    function place(id, entry, level, stretch) {
        var layer = E.comp.layers.add(E.asset(id));
        var scale = 1;
        if (stretch && stretch !== 100) {
            layer.stretch = stretch;
            scale = stretch / 100;
        }
        var audible = audibleLength(id, layer) * scale;
        var offset = hitOffset(id, audible / scale) * scale;
        var start;
        if (entry.anchor === null) {
            start = Math.max(0, entry.t + entry.span / 2 - audible / 2);
        } else {
            start = Math.max(0, entry.anchor - offset);
        }
        layer.startTime = start;
        layer.audio.audioLevels.setValue([level, level]);
        E.soundLog.push({
            item: E.current,
            sound: id,
            level: round(level),
            event: entry.event,
            start: round(start),
            end: round(start + audible),
            animation_start: round(entry.t),
            animation_end: round(entry.t + entry.span),
            role: entry.role,
            series: entry.series,
            anchor: entry.anchor === null ? null : round(entry.anchor),
            hit: round(start + offset)
        });
        return layer;
    }

    // Hits closer than gap merge into the first; too many keep an even spread with the first and last.
    function thinHits(hits, gap, most) {
        var sorted = hits.slice(0).sort(function (a, b) { return a - b; });
        var kept = [];
        for (var i = 0; i < sorted.length; i++) {
            if (!kept.length || sorted[i] - kept[kept.length - 1] >= gap) {
                kept.push(sorted[i]);
            }
        }
        if (most === undefined || kept.length <= most) {
            return kept;
        }
        if (most <= 1) {
            return kept.slice(0, Math.max(0, most));
        }
        var spread = [];
        for (var k = 0; k < most; k++) {
            spread.push(kept[Math.round(k * (kept.length - 1) / (most - 1))]);
        }
        return spread;
    }

    function playSeries(config, series, entry, hits, call) {
        var times = thinHits(hits, series.gap || 0, series.max_hits);
        var sounds = series.sounds || config.tiers || [];
        var layers = [];
        entry.role = "series";
        entry.series = E.current + "/" + call;
        for (var k = 0; k < times.length && sounds.length; k++) {
            var share = times.length > 1 ? k / (times.length - 1) : 0;
            var stretch = series.pitch_step ? 100 / Math.pow(2, series.pitch_step * k / 12) : 100;
            entry.anchor = times[k];
            var shift = (config.level || 0) + (series.fade_db || 0) * share;
            layers.push(place(sounds[k % sounds.length], entry, gain(sounds[k % sounds.length], shift), stretch));
        }
        return layers;
    }

    // A quiet bed under a long animation: starts with it, is cut at its end and fades out.
    function playBed(bed, entry) {
        var layer = E.comp.layers.add(E.asset(bed.sound));
        var end = Math.min(entry.t + entry.span, entry.t + layer.source.duration);
        var fade = Math.min(bed.fade === undefined ? entry.span / 4 : bed.fade, end - entry.t);
        var level = gain(bed.sound, bed.level);
        layer.startTime = entry.t;
        layer.outPoint = end;
        layer.audio.audioLevels.setValueAtTime(end - fade, [level, level]);
        layer.audio.audioLevels.setValueAtTime(end, [-96, -96]);
        E.soundLog.push({
            item: E.current,
            sound: bed.sound,
            event: entry.event,
            start: round(entry.t),
            end: round(end),
            animation_start: round(entry.t),
            animation_end: round(entry.t + entry.span),
            role: "bed",
            series: null,
            anchor: null,
            hit: null
        });
        return layer;
    }

    // length is how long the animation runs from t; hits are the moments its elements should sound.
    // A block may name its sound; false in params turns it off. Events from the base tokens decide the rest:
    // a single sound of the closest length with its strike at the anchor, a series of strikes for a group,
    // a bed under a long animation. Without an anchor the sound and the animation share their centre.
    E.sound = function (params, name, t, length, hits) {
        var span = length === undefined ? E.tokens.motion.pop_duration : length;
        if (params.sound === false || params.sound === null) {
            return [];
        }
        var config = eventConfig(name);
        var entry = { event: name, t: t, span: span, role: "single", series: null, anchor: null };
        if (config === undefined || (params.sound !== undefined && config === null)) {
            var id = params.sound === undefined ? legacySound(name, span) : params.sound;
            if (!id) {
                return [];
            }
            var levels = E.tokens.sounds.levels || {};
            var level = levels[name] === undefined ? gain(id) : levels[name];
            return [place(id, entry, level)];
        }
        if (config === null) {
            return [];
        }
        var call = nextCall();
        if (config.anchor !== undefined) {
            entry.anchor = t + span * config.anchor;
        }
        if (params.sound !== undefined) {
            return [place(params.sound, entry, gain(params.sound, config.level))];
        }
        var layers = [];
        var series = config.series;
        if (series && hits && hits.length >= (series.min_hits || 2) && span >= (series.min_span || 0)) {
            layers = playSeries(config, series, entry, hits, call);
        } else if (config.tiers && config.tiers.length) {
            var chosen = closestTier(config.tiers, span);
            var variants = config.variants && config.variants[chosen];
            if (variants && variants.length) {
                chosen = variants[(itemSeed() + call) % variants.length];
            }
            layers.push(place(chosen, entry, gain(chosen, config.level)));
        }
        if (config.bed && config.bed.sound && span >= (config.bed.min_span || 0)) {
            layers.push(playBed(config.bed, entry));
        }
        return layers;
    };

    // ---- Append over a frozen part. Layers are known by their persistent AE id.
    E.layerIds = function (comp) {
        var ids = {};
        for (var n = 1; n <= comp.numLayers; n++) {
            ids[comp.layer(n).id] = true;
        }
        return ids;
    };

    // Layers created since before (a set from layerIds), in the order they were made.
    E.newLayers = function (comp, before) {
        var fresh = [];
        for (var n = 1; n <= comp.numLayers; n++) {
            var layer = comp.layer(n);
            if (!before[layer.id]) {
                fresh.push(layer);
            }
        }
        fresh.sort(function (a, b) { return a.id - b.id; });
        return fresh;
    };

    function isLayer(value) {
        return value instanceof AVLayer || value instanceof ShapeLayer || value instanceof TextLayer ||
            value instanceof CameraLayer || value instanceof LightLayer;
    }

    function isProperty(value) {
        return value instanceof Property || value instanceof PropertyGroup || value instanceof MaskPropertyGroup;
    }

    // Only plain data of a block is walked: AE objects (footage, text documents, shapes) are left as they are.
    function isPlain(value) {
        return value instanceof Array || value.constructor === Object;
    }

    // Indices from the layer down to a property, with match names to check them on another layer.
    E.propertyPath = function (prop) {
        var path = [];
        for (var p = prop; p.propertyDepth > 0; p = p.parentProperty) {
            path.unshift({ index: p.propertyIndex, match: p.matchName });
        }
        return { layer: prop.propertyGroup(prop.propertyDepth), path: path };
    };

    E.resolvePath = function (layer, path) {
        var p = layer;
        for (var i = 0; p && i < path.length; i++) {
            p = path[i].index <= p.numProperties ? p.property(path[i].index) : null;
            if (p && p.matchName !== path[i].match) {
                p = null;
            }
        }
        return p;
    };

    // Swaps layers, properties and the comp of a replay for the real ones inside a block's store.
    // map: replay layer id -> real layer, or null when the author deleted it (its name goes to missing).
    E.remap = function (value, map, temp, real, missing, seen) {
        seen = seen || [];
        if (value === null || typeof value !== "object") {
            return value;
        }
        if (value === temp) {
            return real;
        }
        if (isLayer(value)) {
            if (!map.hasOwnProperty(value.id)) {
                return value;
            }
            if (map[value.id] === null) {
                missing.push(value.name);
            }
            return map[value.id];
        }
        if (isProperty(value)) {
            var where;
            try {
                where = E.propertyPath(value);
            } catch (e) {
                missing.push("?");
                return null;
            }
            if (!map.hasOwnProperty(where.layer.id)) {
                return value;
            }
            var owner = map[where.layer.id];
            var found = owner ? E.resolvePath(owner, where.path) : null;
            if (!found) {
                missing.push(where.layer.name + " / " + value.name);
            }
            return found;
        }
        if (!isPlain(value)) {
            return value;
        }
        for (var s = 0; s < seen.length; s++) {
            if (seen[s] === value) {
                return value;
            }
        }
        seen.push(value);
        if (value instanceof Array) {
            for (var i = 0; i < value.length; i++) {
                value[i] = E.remap(value[i], map, temp, real, missing, seen);
            }
            return value;
        }
        for (var key in value) {
            if (value.hasOwnProperty(key) && typeof value[key] !== "function") {
                value[key] = E.remap(value[key], map, temp, real, missing, seen);
            }
        }
        return value;
    };

    function leafProperties(group, out) {
        for (var n = 1; n <= group.numProperties; n++) {
            var p = group.property(n);
            if (p.matchName === "ADBE Marker") {
                continue;
            }
            if (p.propertyType === PropertyType.PROPERTY) {
                if (p.canVaryOverTime && p.propertyValueType !== PropertyValueType.NO_VALUE &&
                    p.propertyValueType !== PropertyValueType.CUSTOM_VALUE) {
                    out.push(p);
                }
            } else {
                leafProperties(p, out);
            }
        }
        return out;
    }

    // What the frozen layers look like before the new part: per property its keys, expression and still value.
    E.freezeSnapshot = function (layers) {
        var snap = [];
        for (var i = 0; i < layers.length; i++) {
            var layer = layers[i];
            var entry = { layer: layer, id: layer.id, name: layer.name, inPoint: layer.inPoint, outPoint: layer.outPoint, props: [] };
            var props = leafProperties(layer, []);
            for (var n = 0; n < props.length; n++) {
                var p = props[n];
                var keys = [];
                for (var k = 1; k <= p.numKeys; k++) {
                    keys.push(p.keyTime(k));
                }
                entry.props.push({ path: E.propertyPath(p).path, name: p.name, keys: keys,
                    expression: p.canSetExpression ? p.expression : "", value: keys.length ? null : p.value });
            }
            snap.push(entry);
        }
        return snap;
    };

    function hasTime(list, t) {
        for (var i = 0; i < list.length; i++) {
            if (Math.abs(list[i] - t) < 1e-4) {
                return true;
            }
        }
        return false;
    }

    // Frames before the seam stay exactly as they were: new keys before it go, a still property that got keys
    // holds its old value up to the seam, an old last key holds until the new ones, a new expression starts at
    // the seam, the layer keeps its old in and out before the seam. Returns what had to be fixed.
    E.freezeFix = function (snap, seam) {
        var fixes = [];
        for (var i = 0; i < snap.length; i++) {
            var entry = snap[i];
            var layer = entry.layer;
            if (Math.abs(layer.inPoint - entry.inPoint) > 1e-4) {
                layer.inPoint = entry.inPoint;
                fixes.push({ layer: entry.name, property: "inPoint", fix: "restored" });
            }
            if (layer.outPoint < seam - 1e-4 && Math.abs(layer.outPoint - entry.outPoint) > 1e-4) {
                layer.outPoint = Math.min(entry.outPoint, seam);
                fixes.push({ layer: entry.name, property: "outPoint", fix: "restored" });
            }
            for (var n = 0; n < entry.props.length; n++) {
                var old = entry.props[n];
                var p = E.resolvePath(layer, old.path);
                if (!p) {
                    continue;
                }
                var expression = p.canSetExpression ? p.expression : "";
                if (expression !== old.expression) {
                    p.expression = "if (time < " + seam + ") {\n" + (old.expression || "value") + "\n} else {\n" + expression + "\n}";
                    fixes.push({ layer: entry.name, property: old.name, fix: "expression from the seam" });
                }
                if (p.numKeys === old.keys.length) {
                    continue;
                }
                var removed = 0;
                for (var k = p.numKeys; k >= 1; k--) {
                    var t = p.keyTime(k);
                    if (t < seam - 1e-4 && !hasTime(old.keys, t)) {
                        p.removeKey(k);
                        removed += 1;
                    }
                }
                if (removed) {
                    fixes.push({ layer: entry.name, property: old.name, fix: "removed " + removed + " keys before the seam" });
                }
                if (!p.numKeys || p.numKeys === old.keys.length) {
                    continue;
                }
                var before = 0;
                for (var b = 1; b <= p.numKeys; b++) {
                    if (p.keyTime(b) < seam - 1e-4) {
                        before = b;
                    }
                }
                if (!old.keys.length) {
                    // A still property: its old value up to the seam, then the new animation.
                    // A held key with the old value just before the new ones: frames before stay, the new start stays.
                    var t0 = p.keyTime(1) > seam + 1e-4 ? seam : p.keyTime(1) - 0.001;
                    p.setValueAtTime(t0, old.value);
                    var first = p.nearestKeyIndex(t0);
                    p.setInterpolationTypeAtKey(first, KeyframeInterpolationType.HOLD, KeyframeInterpolationType.HOLD);
                    fixes.push({ layer: entry.name, property: old.name, fix: "held until the seam" });
                } else if (before && before < p.numKeys && hasTime(old.keys, p.keyTime(before)) &&
                    !hasTime(old.keys, p.keyTime(before + 1))) {
                    // The old last key before the seam used to be held: it stays held until the new keys.
                    var lastOld = true;
                    for (var o = 0; o < old.keys.length; o++) {
                        lastOld = lastOld && old.keys[o] <= p.keyTime(before) + 1e-4;
                    }
                    if (lastOld) {
                        p.setInterpolationTypeAtKey(before, p.keyInInterpolationType(before), KeyframeInterpolationType.HOLD);
                        fixes.push({ layer: entry.name, property: old.name, fix: "old last key held" });
                    }
                }
            }
        }
        return fixes;
    };

    return E;
})();
