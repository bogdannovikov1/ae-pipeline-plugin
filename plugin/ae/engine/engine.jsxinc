                    }
                }
            });
        }
        for (i = 0; i < (links || []).length; i++) {
            var link = links[i];
            for (var t = 0; t < link.targets.length; t++) {
                for (n = 1; n <= comp.numLayers; n++) {
                    if (comp.layer(n).comment !== "scene:" + link.targets[t]) {
                        continue;
                    }
                    for (var l = 0; l < link.layers.length; l++) {
                        var user = link.layers[l];
