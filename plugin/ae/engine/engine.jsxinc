            byId[layer.id] = r;
            byIndex[n] = r;
            byName[layer.name] = (byName[layer.name] || []).concat([r]);
        }
        function need(target, owner) {
            if (target && owner && target !== owner) {
                target.deps.push(owner);
            }
        }
        for (i = 0; i < records.length; i++) {
            var owner = records[i];
            if (owner.layer.parent) {
                need(byId[owner.layer.parent.id], owner);
            }
            eachProperty(owner.layer, function (p) {
                if (PropertyValueType.LAYER_INDEX !== undefined && p.propertyValueType === PropertyValueType.LAYER_INDEX) {
                    need(byIndex[p.value], owner);
                }
                if (!p.canSetExpression || !p.expressionEnabled || !p.expression) {
                    return;
                }
                var refs = E.layerRefs(p.expression);
                if (refs.unknown) {
                    anyone.push(owner);
                }
                for (var a = 0; a < refs.indices.length; a++) {
                    need(byIndex[refs.indices[a]], owner);
                }
                for (var b = 0; b < refs.names.length; b++) {
                    var named = byName[refs.names[b]] || [];
                    for (var c = 0; c < named.length; c++) {
