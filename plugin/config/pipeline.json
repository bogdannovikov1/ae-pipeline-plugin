{
  "stages": [
    {
      "id": "voice",
      "title": "Голос из текста",
      "executor": "orchestrator",
      "needs": [],
      "inputs": [
        "{f}.voice.txt"
      ],
      "outputs": [
        "{f}.wav"
      ],
      "validate": "voice",
      "track_outputs": false,
      "skip_if_audio": true,
      "review": "author"
    },
    {
      "id": "transcript",
      "title": "Транскрипт",
      "executor": "transcriber",
      "needs": [],
      "inputs": [
        "{audio}"
      ],
      "outputs": [
        "{f}.timeline.json"
      ],
      "validate": "timeline",
      "review": "author"
    },
    {
      "id": "plan",
      "title": "План анимации",
      "executor": "director",
      "needs": [
        "transcript"
      ],
      "inputs": [
        "{f}.timeline.json"
      ],
      "outputs": [
        "{f}.animation.json"
      ],
      "validate": "animation",
      "review": "author"
    },
    {
      "id": "build",
      "title": "Сборка",
      "executor": "animator",
      "needs": [
        "plan"
      ],
      "inputs": [
        "{f}.timeline.json",
        "{f}.animation.json"
      ],
      "outputs": [
        "{f}.scene.json"
      ],
      "validate": "scene",
      "review": "auto",
      "needs_build": true
    },
    {
      "id": "check",
      "title": "Ревью кода",
      "executor": "checker",
      "needs": [
        "build"
      ],
      "inputs": [
        "{f}.timeline.json",
        "{f}.animation.json",
        "{f}.scene.json"
      ],
      "outputs": [
        "reviews/{f}.check.json"
      ],
      "track_outputs": false,
      "validate": "check",
      "review": "once"
    },
    {
      "id": "preflight",
      "title": "Предревью",
      "executor": "reviewer",
      "needs": [
        "check"
      ],
      "inputs": [
        "{f}.scene.json"
      ],
      "outputs": [],
      "review": "rounds",
      "optional": true
    },
    {
      "id": "polish",
      "title": "Доводка автором",
      "executor": "author",
      "needs": [
        "preflight"
      ],
      "inputs": [
        "{f}.scene.json"
      ],
      "outputs": [
        "{f}.aep"
      ],
      "track_outputs": false,
      "protected": true,
      "review": "author"
    },
    {
      "id": "curate",
      "title": "Обновление базы",
      "executor": "librarian",
      "needs": [
        "polish"
      ],
      "inputs": [
        "{f}.scene.json"
      ],
      "outputs": [
        "{f}.base_proposals.md"
      ],
      "track_outputs": false,
      "periodic": true,
      "review": "author",
      "optional": true
    }
  ]
}
