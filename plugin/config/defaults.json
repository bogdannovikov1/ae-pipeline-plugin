{
  "bases_dir": "~/Documents/ae-video/bases",
  "base": "starter",
  "labs_dir": "~/Documents/ae-video/labs",
  "sound_library_dir": "~/Documents/ae-video/sound_library",
  "videos_dir": "~/Documents/ae-video/videos",
  "first_fragment": "01",
  "agents_file": "AGENTS.md",
  "transcribe": {
    "model": "mlx-community/whisper-large-v3-turbo",
    "language": "ru",
    "review_below": 0.6,
    "backend": "mlx",
    "device": "auto",
    "compute_type": "default"
  },
  "refine": {
    "frame_seconds": 0.01,
    "min_voiced_frames": 2,
    "max_gap_frames": 15,
    "max_below_speech_db": 40,
    "pad_start": 0.03,
    "pad_end": 0.04,
    "threshold_position": 0.25,
    "sample_rate": 16000,
    "noise_percentile": 10,
    "speech_percentile": 90
  },
  "ae": {
    "app": "Adobe After Effects 2026",
    "timeout": 500,
    "autosave_projects": [],
    "launch_timeout": 240,
    "review_width": 1920,
    "review_height": 1080,
    "review_fps": 30,
    "keep_builds": 1,
    "trim_hidden": true,
    "trim_pad": 0.5,
    "mute_offscreen": true,
    "offscreen_margin": 0,
    "apps_dir": "/Applications",
    "ready_check_timeout": 20,
    "ready_check_pause": 3,
    "frame_poll_seconds": 0.5
  },
  "code_review": {
    "enabled": true,
    "min_seconds": 0,
    "block_on": "major"
  },
  "review": {
    "max_rounds": 3,
    "block_on": "major",
    "max_frames": 48,
    "offsets": [
      -0.1,
      0.0,
      0.25
    ],
    "frame_timeout": 240,
    "sheet_columns": 4,
    "sheet_rows": 4,
    "sheet_frame_width": 480
  },
  "base_update": {
    "every_fragments": 1,
    "min_repeats": 2
  },
  "extend": {
    "gap_seconds": 0.4
  },
  "timing": {
    "max_early": 0.4,
    "long_phrase_words": 7,
    "long_phrase_seconds": 2.5,
    "long_phrase_zone": 0.5,
    "sound_min_gap": 0.3,
    "sound_series_gap": 0.08,
    "sound_max_shift": 0.03,
    "fast_words_per_second": 3.2
  },
  "layout": {
    "safe_margin": 96,
    "min_overlap": 8,
    "full_frame": 0.9,
    "settle": 0.8,
    "max_layers_per_minute": 80,
    "max_jump_px": 160,
    "flash_delta": 60,
    "exit_allowance": 1.0,
    "visible_ahead": 0.5,
    "visible_behind": 0.05,
    "bottom_zone": 0.75,
    "frame_tolerance": 1.5,
    "stuck_seconds": 1.0,
    "opaque_percent": 95,
    "min_minutes": 0.5
  },
  "diff": {
    "px": 0.5,
    "scale": 0.002,
    "degrees": 0.05,
    "seconds": 0.002,
    "max_lines": 10
  },
  "lab": {
    "seconds": 4,
    "part_seconds": 6,
    "word_seconds": 0.5,
    "start_word": 2,
    "tail": 1.0,
    "width": 1920,
    "height": 1080,
    "sample_rate": 16000
  },
  "plan_check": {
    "helper_blocks": [
      "appear",
      "move",
      "label",
      "group",
      "stagger_in",
      "idle",
      "attach"
    ]
  },
  "voice": {
    "api_url": "https://api.elevenlabs.io",
    "keychain_service": "ae-video-elevenlabs",
    "model": "eleven_v4",
    "voice_name": "",
    "voice_settings": {
      "stability": 0.5
    },
    "allowed_tags": [
      "slightly faster",
      "thoughtful",
      "short pause",
      "emphasized"
    ],
    "tag_hints": {
      "slightly faster": "перечисление, пояснение, связки",
      "thoughtful": "вопрос, вывод, размышление",
      "short pause": "смена мысли, пауза перед важным",
      "emphasized": "главное утверждение"
    },
    "spoken_forms": {},
    "notation_pattern": "[A-Za-zА-Яа-яЁё]\\([^()]*\\)|[²³√∑∫≤≥≠×÷^]",
    "direction_pattern": "(?:^|(?<=\\s))\\(((?:[^()]|\\([^()]*\\))+)\\)",
    "direction_context_words": 6,
    "formats": [
      "pcm_44100",
      "mp3_44100_192"
    ],
    "pcm_rate": 44100,
    "max_chars": 2500,
    "timeout": 180,
    "sample_rate": 48000,
    "codec": "pcm_s24le",
    "eq": [],
    "search_page_size": 100
  },
  "doctor": {
    "font_folders": [
      "~/Library/Fonts",
      "/Library/Fonts"
    ]
  },
  "sound_measure": {
    "rate": 22050,
    "silence_below_peak_db": 30,
    "tail_tolerance": 0.02
  },
  "sound_library": {
    "preview_rate": 22050,
    "pop": 0.45,
    "preview_groups": {
      "массив 10": [
        0.0,
        0.12,
        0.24,
        0.36,
        0.48,
        0.6,
        0.72,
        0.84,
        0.96,
        1.08
      ],
      "граф 4 уровня": [
        0,
        0.4,
        0.8,
        1.2
      ]
    },
    "preview_series_group": "граф 4 уровня",
    "target_db": -20,
    "max_gain_db": 15,
    "series_gap": 0.08,
    "series_max_hits": 10,
    "series_fade_db": -6,
    "single_offset": 0.05,
    "bed_gain_db": -10,
    "draft_series": {
      "min_hits": 3,
      "min_span": 0.7,
      "gap": 0.1,
      "max_hits": 10,
      "fade_db": -6,
      "pitch_step": 0
    },
    "draft_bed": {
      "min_span": 1.2,
      "level": -10
    },
    "draft_level": -14,
    "draft_reference_loudness": -20
  },
  "platforms": {
    "win32": {
      "transcribe": {
        "backend": "faster-whisper",
        "model": "large-v3-turbo"
      },
      "ae": {
        "apps_dir": "C:/Program Files/Adobe",
        "exe": "Support Files/AfterFX.exe"
      },
      "doctor": {
        "font_folders": [
          "%WINDIR%/Fonts",
          "%LOCALAPPDATA%/Microsoft/Windows/Fonts"
        ]
      }
    }
  }
}
