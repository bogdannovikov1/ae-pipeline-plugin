{
  "bases_dir": "~/Documents/ae-video/bases",
  "base": "starter",
  "labs_dir": "~/Documents/ae-video/labs",
  "sound_library_dir": "~/Documents/ae-video/sound_library",
  "videos_dir": "~/Documents/ae-video/videos",
  "first_fragment": "01",
  "agents_file": "AGENTS.md",
  "transcribe": {
    "model": "mlx-community/whisper-large-v3-turbo",
    "language": "ru",
    "review_below": 0.6
  },
  "refine": {
    "frame_seconds": 0.01,
    "min_voiced_frames": 2,
    "max_gap_frames": 15,
    "max_below_speech_db": 40,
    "pad_start": 0.03,
    "pad_end": 0.04,
    "threshold_position": 0.25
  },
  "ae": {
    "app": "Adobe After Effects 2026",
    "timeout": 500,
    "autosave_projects": [],
    "launch_timeout": 240,
    "review_width": 1920,
    "review_height": 1080,
    "review_fps": 30,
    "keep_builds": 1
  },
  "code_review": {
    "enabled": true,
    "min_seconds": 0,
    "block_on": "major"
  },
  "review": {
    "max_rounds": 3,
    "block_on": "major",
    "max_frames": 48,
    "offsets": [
      -0.1,
      0.0,
      0.25
    ],
    "frame_timeout": 240,
    "sheet_columns": 4,
    "sheet_rows": 4,
    "sheet_frame_width": 480
  },
  "base_update": {
    "every_fragments": 1,
    "min_repeats": 2
  },
  "extend": {
    "gap_seconds": 0.4
  },
  "timing": {
    "max_early": 0.4,
    "long_phrase_words": 7,
    "long_phrase_seconds": 2.5,
    "long_phrase_zone": 0.5,
    "sound_min_gap": 0.3,
    "sound_series_gap": 0.08,
    "sound_max_shift": 0.03,
    "fast_words_per_second": 3.2
  },
  "layout": {
    "safe_margin": 96,
    "min_overlap": 8,
    "full_frame": 0.9,
    "settle": 0.8,
    "max_layers_per_minute": 80,
    "max_jump_px": 160,
    "flash_delta": 60,
    "exit_allowance": 1.0
  },
  "lab": {
    "seconds": 4,
    "part_seconds": 6,
    "word_seconds": 0.5,
    "start_word": 2,
    "tail": 1.0,
    "width": 1920,
    "height": 1080
  },
  "plan_check": {
    "helper_blocks": [
      "appear",
      "move",
      "label",
      "group",
      "stagger_in",
      "idle",
      "attach"
    ]
  },
  "voice": {
    "api_url": "https://api.elevenlabs.io",
    "keychain_service": "ae-video-elevenlabs",
    "model": "eleven_v4",
    "voice_name": "",
    "voice_settings": {
      "stability": 0.5
    },
    "allowed_tags": [
      "slightly faster",
      "thoughtful",
      "short pause",
      "emphasized"
    ],
    "tag_hints": {
      "slightly faster": "перечисление, пояснение, связки",
      "thoughtful": "вопрос, вывод, размышление",
      "short pause": "смена мысли, пауза перед важным",
      "emphasized": "главное утверждение"
    },
    "spoken_forms": {},
    "notation_pattern": "[A-Za-zА-Яа-яЁё]\\s*\\([^()]*\\)|[²³√∑∫≤≥≠×÷^]",
    "formats": [
      "pcm_44100",
      "mp3_44100_192"
    ],
    "pcm_rate": 44100,
    "max_chars": 2500,
    "timeout": 180,
    "sample_rate": 48000,
    "codec": "pcm_s24le",
    "eq": [],
    "search_page_size": 100
  }
}
