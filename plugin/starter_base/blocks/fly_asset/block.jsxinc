// fly_asset
Engine.register("fly_asset", function (params, at, id) {
    var item = Engine.asset(params.asset);
    var layer = Engine.comp.layers.add(item);
    var ratio = params.size / Math.max(item.width, item.height) * 100;
    layer.scale.setValue([ratio, ratio]);
    // The spring reaches the target by the word.
    var start = Engine.spring(layer, at, params.from, params.to);
    Engine.shadow(layer);
    return [layer].concat(Engine.sound(params, "move", start, at - start));
});
